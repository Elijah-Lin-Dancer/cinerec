# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# Environment
.env
.venv/
venv/

# Database
*.db
*.db.bak
*.db-journal
*.db-wal

# Data — heavy downloads are excluded; the small seed files are kept so a fresh
# clone can build the database without re-downloading MovieLens.
data/raw/*.zip
data/raw/ml-100k/

# Processed artifacts: ignore everything by default, then explicitly ship the
# minimum needed to serve recommendations on a fresh clone (trained models +
# content features + enriched metadata). See docs/adr/0002-artifact-storage.md.
data/processed/*
!data/processed/.gitkeep
!data/processed/eval_results.json
!data/processed/eval_multiseed.json
!data/processed/ablation_results.json
!data/processed/ablation_multiseed.json
!data/processed/coldstart_results.json
!data/processed/coldstart_multiseed.json
!data/processed/recs_cache.json
!data/processed/movies_enriched.json
!data/processed/genre_vectors.npy
!data/processed/text_embeddings.npy
!data/processed/image_embeddings.npy
!data/processed/model_usercf.pkl
!data/processed/model_itemcf.pkl
!data/processed/model_svd.pkl
!data/processed/model_lightgcn.pkl
!data/processed/model_neumf.pt
!data/processed/model_multimodalncf.pt

# Second-dataset subtrees (CINEREC_DATASET, e.g. amazon-video-games): the heavy
# upstream downloads and the 20MB+ feature arrays stay out — the shipped evidence
# is the slice definition (ratings.csv) plus the measured result JSONs. Everything
# else is rebuilt with the documented make/docker commands.
data/datasets/*/raw/*
!data/datasets/*/raw/ratings.csv
data/datasets/*/processed/*
!data/datasets/*/processed/eval_results.json
!data/datasets/*/processed/eval_multiseed.json
!data/datasets/*/processed/ablation_results.json
!data/datasets/*/processed/ablation_multiseed.json
!data/datasets/*/processed/coldstart_results.json
!data/datasets/*/processed/coldstart_multiseed.json
!data/datasets/*/processed/category_vocab.json

# Test / coverage artefacts
.coverage
.coverage.*
htmlcov/

# Build
dist/
build/

# LaTeX build artifacts (the typeset PDF itself is committed for the preprint)
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
docs/paper.bbl

# Local scratch / working files
scratch/
*.local
*.bak
*.orig
*.rej
*.tmp

# Node
node_modules/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Screenshots are committed so the README renders on GitHub / in the portfolio.