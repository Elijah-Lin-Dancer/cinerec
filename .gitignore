# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# Environment
.env
.venv/
venv/

# Database
*.db
*.db.bak
*.db-journal
*.db-wal

# Data — heavy downloads are excluded; the small seed files are kept so a fresh
# clone can build the database without re-downloading MovieLens.
data/raw/*.zip
data/raw/ml-100k/

# Processed artifacts: ignore everything by default, then explicitly ship the
# minimum needed to serve recommendations on a fresh clone (trained models +
# content features + enriched metadata). See docs/adr/0002-artifact-storage.md.
data/processed/*
!data/processed/.gitkeep
!data/processed/eval_results.json
!data/processed/ablation_results.json
!data/processed/coldstart_results.json
!data/processed/recs_cache.json
!data/processed/movies_enriched.json
!data/processed/genre_vectors.npy
!data/processed/text_embeddings.npy
!data/processed/image_embeddings.npy
!data/processed/model_usercf.pkl
!data/processed/model_itemcf.pkl
!data/processed/model_svd.pkl
!data/processed/model_neumf.pt
!data/processed/model_multimodalncf.pt

# Build
dist/
build/

# Node
node_modules/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

