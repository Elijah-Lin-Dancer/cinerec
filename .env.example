TMDB_API_KEY=your_api_key_here
# full = real-time model inference (needs torch) · lite = precomputed cache
APP_MODE=full
# HMAC key for session tokens. Set a long random value in production; if left
# unset the app generates an ephemeral one (tokens then reset on restart).
# e.g. CINEREC_SECRET=$(python -c "import secrets; print(secrets.token_hex(32))")
CINEREC_SECRET=
# Optional: signed-token lifetime in seconds (default 604800 = 7 days).
# CINEREC_TOKEN_TTL=604800
